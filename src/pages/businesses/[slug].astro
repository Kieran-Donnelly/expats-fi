---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { businesses } from '../../data/businesses';

export const prerender = true;
export function getStaticPaths() {
  return businesses.map((business) => ({ params: { slug: business.slug }, props: { business } }));
}
const { business } = Astro.props;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: business.name,
  description: business.summary,
  url: business.website,
  telephone: business.phone,
  address: business.address,
};
---
<BaseLayout title={business.name} description={business.summary}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  <article class="profile shell">
    <a class="back-link" href="/businesses/">← All businesses</a>
    <div class="profile__heading">
      <div><p class="kicker">{business.categories.join(' · ')}</p><h1>{business.name}</h1><p class="profile__summary">{business.summary}</p></div>
      <div class="profile__initial" aria-hidden="true">{business.name.charAt(0)}</div>
    </div>
    <div class="profile__body">
      <div class="prose"><h2>About {business.name}</h2><p>{business.description}</p></div>
      <aside class="facts" aria-label="Business details">
        <div><span>Location</span><strong>{business.locations.join(', ')}</strong><small>{business.address}</small></div>
        <div><span>Phone</span><a href={`tel:${business.phone.replace(/\s/g, '')}`}>{business.phone}</a></div>
        <a class="button" href={business.website} target="_blank" rel="noopener">Visit website ↗</a>
        <p>Business details can change. Check the business website before travelling.</p>
      </aside>
    </div>
  </article>
</BaseLayout>
