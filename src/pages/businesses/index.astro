---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BusinessCard from '../../components/BusinessCard.astro';
import FilterBar from '../../components/FilterBar.astro';
import { businesses, businessCategories, businessLocations } from '../../data/businesses';
---
<BaseLayout title="Expat-owned businesses in Finland" description="Search expat-owned restaurants, services and independent businesses across Finland.">
  <header class="page-hero">
    <div class="shell page-hero__inner">
      <div><p class="kicker">Business directory</p><h1>Find expat-owned businesses in Finland</h1></div>
      <p>From a proper pizza to a reliable barber, discover businesses built by people who now call Finland home.</p>
    </div>
  </header>
  <section class="directory shell">
    <FilterBar kind="businesses" categories={businessCategories} locations={businessLocations} />
    <div class="business-grid">
      {businesses.map((business) => <BusinessCard business={business} />)}
    </div>
    <div class="empty-state" data-empty-state hidden><h2>No exact matches yet</h2><p>Try a broader search, or help us add the business you were looking for.</p><a class="button" href="/submit-business/">Suggest a business</a></div>
  </section>
</BaseLayout>
