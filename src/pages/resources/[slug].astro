---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articles } from '../../data/articles';

export const prerender = true;
export function getStaticPaths() {
  return articles.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}
const { article } = Astro.props;
const date = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(article.publishedAt));
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.title,
  description: article.description,
  datePublished: article.publishedAt,
  author: { '@type': 'Organization', name: 'Expats.fi' },
  publisher: { '@type': 'Organization', name: 'Expats.fi' },
};
---
<BaseLayout title={article.title} description={article.description} type="article">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  <article class="article shell">
    <a class="back-link" href="/resources/">← Resource library</a>
    <header class="article__header">
      <p class="kicker">{article.category}</p>
      <h1>{article.title}</h1>
      <p class="article__description">{article.description}</p>
      <div class="article__meta"><span>Published {date}</span><span>{article.readingMinutes} min read</span></div>
    </header>
    <div class="article__layout">
      <div class="prose prose--article" set:html={article.html} />
      <aside class="article-note"><strong>Check before you act</strong><p>Rules, fees and processing times change. Use this guide as a starting point and confirm your situation with the relevant official Finnish authority.</p></aside>
    </div>
  </article>
</BaseLayout>
