---
const { kind, categories = [], locations = [] } = Astro.props as { kind: 'businesses' | 'resources'; categories?: string[]; locations?: string[] };
---
<form class="filter-bar" data-filter-form data-kind={kind} role="search">
  <label class="filter-bar__search">
    <span>Search</span>
    <input type="search" name="query" placeholder={kind === 'businesses' ? 'Name, service or place' : 'Search guides'} autocomplete="off" />
  </label>
  <label>
    <span>Category</span>
    <select name="category">
      <option value="">All categories</option>
      {categories.map((category) => <option value={category.toLowerCase()}>{category}</option>)}
    </select>
  </label>
  {locations.length > 0 && (
    <label>
      <span>Location</span>
      <select name="location">
        <option value="">All locations</option>
        {locations.map((location) => <option value={location.toLowerCase()}>{location}</option>)}
      </select>
    </label>
  )}
  <p class="filter-bar__count" aria-live="polite"><strong data-result-count>0</strong> results</p>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-filter-form]');
  const items = [...document.querySelectorAll<HTMLElement>('[data-search-item]')];
  const count = document.querySelector<HTMLElement>('[data-result-count]');
  const empty = document.querySelector<HTMLElement>('[data-empty-state]');

  const update = () => {
    if (!form) return;
    const data = new FormData(form);
    const query = String(data.get('query') || '').trim().toLowerCase();
    const category = String(data.get('category') || '');
    const location = String(data.get('location') || '');
    let visible = 0;
    items.forEach((item) => {
      const haystack = `${item.dataset.name || ''} ${item.dataset.title || ''} ${item.dataset.category || ''} ${item.dataset.location || ''}`;
      const show = (!query || haystack.includes(query)) && (!category || (item.dataset.category || '').includes(category)) && (!location || (item.dataset.location || '').includes(location));
      item.hidden = !show;
      if (show) visible += 1;
    });
    if (count) count.textContent = String(visible);
    if (empty) empty.hidden = visible !== 0;
  };
  form?.addEventListener('input', update);
  update();
</script>
