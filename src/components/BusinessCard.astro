---
import type { Business } from '../data/businesses';
const { business } = Astro.props as { business: Business };
---
<article class="business-card" data-search-item data-name={business.name.toLowerCase()} data-category={business.categories.join(' ').toLowerCase()} data-location={business.locations.join(' ').toLowerCase()}>
  <div class="business-card__topline">
    <span>{business.categories[0]}</span>
    <span>{business.locations.join(' · ')}</span>
  </div>
  <h2><a href={`/businesses/${business.slug}/`}>{business.name}</a></h2>
  <p>{business.summary}</p>
  <a class="text-link" href={`/businesses/${business.slug}/`}>View {business.name} <span aria-hidden="true">→</span></a>
</article>
