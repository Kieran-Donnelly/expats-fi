---
import '../styles/global.css';

type Props = {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
};

const {
  title = 'Expats.fi | Find your feet in Finland',
  description = 'Expat-owned businesses and practical, plain-English guides for life in Finland.',
  image = '/social-card.svg',
  type = 'website',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const pageTitle = title.includes('Expats.fi') ? title : `${title} | Expats.fi`;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#153a44" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:site_name" content="Expats.fi" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="shell site-header__inner">
        <a class="brand" href="/" aria-label="Expats.fi home">
          <span class="brand__mark" aria-hidden="true">E</span>
          <span class="brand__name">expats<span>.fi</span></span>
        </a>
        <nav class="site-nav" aria-label="Primary navigation">
          <a href="/businesses/" aria-current={currentPath.startsWith('/business') ? 'page' : undefined}>Businesses</a>
          <a href="/resources/" aria-current={currentPath.startsWith('/resources') ? 'page' : undefined}>Life in Finland</a>
          <a class="button button--small" href="/submit-business/">List your business</a>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="shell site-footer__grid">
        <div>
          <a class="brand brand--footer" href="/">
            <span class="brand__mark" aria-hidden="true">E</span>
            <span class="brand__name">expats<span>.fi</span></span>
          </a>
          <p>Useful local knowledge, built with Finland’s international community.</p>
        </div>
        <nav aria-label="Footer navigation">
          <a href="/businesses/">Business directory</a>
          <a href="/resources/">Resource library</a>
          <a href="/submit-business/">List your business</a>
        </nav>
        <div class="site-footer__small">
          <p>Information is general guidance, not legal advice. Always check official sources for current rules.</p>
          <p>© {new Date().getFullYear()} Expats.fi</p>
        </div>
      </div>
    </footer>
  </body>
</html>
